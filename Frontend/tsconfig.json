{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "app/(root)/(tabs)/index.js",
    "components/Header.js",
    "app/(root)/(tabs)/_layout.js",
    "app/(root)/(tabs)/wishlist.js",
    "app/(root)/(tabs)/profile.js",
    "app/(root)/(tabs)/categories.js",
    "app/(root)/(tabs)/cart.js"
  ]
}
